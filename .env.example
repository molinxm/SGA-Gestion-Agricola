# ============================================================================
#  SGA · Sistema de Gestión Agrícola — Plantilla de variables de entorno
#
#  CÓMO USARLO
#    1. Copia este archivo y renómbralo a  .env
#    2. Rellena tus propias contraseñas
#    3. El archivo .env está excluido en .gitignore: nunca se sube al repo
#
#  Ninguna credencial real vive en el código: todas se leen desde aquí.
# ============================================================================

# --- Conexión a MySQL -------------------------------------------------------
SGA_DB_HOST=localhost
SGA_DB_PORT=3306
SGA_DB_USER=root
SGA_DB_PASSWORD=tu_contrasena_aqui
SGA_DB_NAME=gestion_agricola

# --- Clave secreta de Flask (firma las cookies de sesión) -------------------
# Genera una propia, por ejemplo con:
#     py -c "import secrets; print(secrets.token_hex(32))"
SGA_SECRET_KEY=cambia-esta-clave-en-produccion

# --- Contraseñas de las cuentas semilla (flask --app app init-db) -----------
# Si dejas una vacía, esa cuenta simplemente no se crea.
SGA_ADMIN_PASSWORD=tu_contrasena_admin
SGA_SUPERVISOR_PASSWORD=tu_contrasena_supervisor
SGA_OPERARIO_PASSWORD=tu_contrasena_operario
